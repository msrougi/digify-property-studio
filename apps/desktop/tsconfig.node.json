{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["electron-vite/node"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/application/**/*",
    "src/infrastructure/**/*",
    "src/test-support/**/*",
    "src/types/**/*"
  ]
}
